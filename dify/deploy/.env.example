# 复制为 .env 后按需修改；不要提交真实密钥。
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=absurd_court

POWERCONTEXT_BASE_URL=http://127.0.0.1:8000
POWERCONTEXT_ENABLED=1
POWERCONTEXT_TIMEOUT=4
POWERCONTEXT_SCOPE_PREFIX=absurd-court

# 默认零依赖哈希向量；切换真实 Embedding 时同时改维度并重建索引
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=128
# EMBEDDING_BACKEND=openai
# EMBEDDING_API_KEY=sk-REPLACE_ME
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

COURT_MAX_TURNS=3
COURT_AUTO_INIT=1

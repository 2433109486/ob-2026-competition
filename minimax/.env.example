# Copy to .env and fill placeholders. Never commit a real key.
MINIMAX_API_KEY=replace-with-your-minimax-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_EMBEDDING_MODEL=embo-01

SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=sdd_context

POWERCONTEXT_URL=http://127.0.0.1:8765
POWERCONTEXT_SCOPE_FILE=demo/runtime/powercontext_scope.txt
POWERCONTEXT_STATE_KIND=sdd_task_state

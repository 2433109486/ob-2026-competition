# 研脉 ResearchPulse - local configuration
# seekdb 1.4 (MySQL protocol)
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=yanmai

# PowerContext 1.4.1 HTTP API
POWERCONTEXT_URL=http://127.0.0.1:8765
POWERCONTEXT_ENABLED=true
POWERCONTEXT_SCOPE_KEY=yanmai-research-v1
POWERCONTEXT_SCOPE_FILE=runtime/powercontext_scope.txt

# Local web app
APP_HOST=127.0.0.1
APP_PORT=7860

# Optional: only needed if the UI is served from a different origin
ALLOWED_ORIGINS=

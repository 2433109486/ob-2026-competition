# App
HOST=127.0.0.1
PORT=5173

# seekdb 1.4. auto probes :2881, then auto-starts an installed seekdb binary.
SEEKDB_MODE=auto
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=stepfun_kb
# Optional explicit binary path; auto-detected from PATH when empty.
# SEEKDB_BIN=/path/to/seekdb
# SEEKDB_BASE_DIR=./runtime/seekdb-server-managed

# Linux/macOS only: embedded mode, no local server required.
# SEEKDB_MODE=embedded
# SEEKDB_PATH=./runtime/seekdb-embedded

# Model / retrieval
MODEL_ID=bge-small-zh-v1.5
MODEL_DIM=512
MODEL_DTYPE=q8
DEFAULT_COLLECTION=default
FULLTEXT_ANALYZER=ngram2
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=64
